# DataHub connection (for --mcp / --graphql modes)
# Copy to .env and fill in your values.

# Your DataHub server URL
DATAHUB_URL=http://localhost:8080

# Your DataHub personal access token
# Generate one at: DataHub UI → Settings → Access Tokens
DATAHUB_TOKEN=

# MCP server command (defaults to npx -y @acryldata/mcp-server-datahub)
# Override if you run the server differently
# MCP_SERVER_COMMAND=npx
# MCP_SERVER_ARGS=-y @acryldata/mcp-server-datahub

# Enable mutation tools on the MCP server (required for write-back)
TOOLS_IS_MUTATION_ENABLED=true
